---
import Logotipo from "@/components/Logotipo.astro";
---

<footer class="bg-white pt-16 pb-8 border-t border-[#e2e8f077]">
  <div
    class="w-[90%] max-w-7xl mx-auto grid gap-12 mb-12 grid-cols-[2fr_1fr_1fr]"
  >
    <div class="footer-col">
