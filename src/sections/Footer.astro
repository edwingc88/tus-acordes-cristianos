        <a href="#" class="flex items-center gap-1.5 cursor-pointer">
          <div
            class="w-24 h-24 bg-gradient-primary flex justify-between text-white relative"
          >
            <img src="/public/tus.png" alt="Logo" />
          </div>
          <div class="flex flex-col justify-center">
            <h1
              class="text-3xl font-bold text-primary leading-none tracking-[1px]"
            >
              ACORDES
            </h1>
            <span class="text-2xl font-semibold text-secondary tracking-[1px]"
              >CRISTIANOS</span
            >
          </div>
