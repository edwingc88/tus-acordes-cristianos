---
import Layout from "../layouts/Layout.astro";
const title = "Login";
const description =
  "Encuentra acordes, letras y diagramas para guitarra y piano de tus canciones cristianas favoritas";
const canonical = "https://www.tusacordescristianos.com/login";
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="login-card grid grid-cols-10 mx-auto mt-5 mb-12">
    <div class="card-1 col-span-6 bg-white p-5 rounded-l-2xl">
      <div class="social-login">
        <button class="btn-google">
          <img
            src="https://www.gstatic.com/images/branding/product/1x/gsa_512dp.png"
            alt="Google Logo"
          />
          Continuar con Google
        </button>
      </div>
      <h1
        class="bg-linear-to-r from-primary to-secondary bg-clip-text text-transparent text-3xl font-bold my-2"
      >
        INICIAR SESION
      </h1>
      <p class="text-sm font-medium mb-5">Ingresa en tu cuenta</p>
      <form class="w-80 mx-auto">
        <div class="form-group">
          <label>Correo Electrónico</label>
          <div class="input-wrapper">
            <i data-lucide="mail"></i>
            <input
              type="email"
              class="form-control"
              placeholder="ejemplo@correo.com"
              required
            />
          </div>
        </div>

        <div class="form-group">
          <label>Contraseña</label>
          <div class="input-wrapper">
            <i data-lucide="lock"></i>
            <input
              type="password"
              class="form-control"
              placeholder="••••••••"
              required
            />
          </div>
          <a href="#" class="forgot-password">¿Olvidaste tu contraseña?</a>
        </div>

        <button type="submit" class="btn-submit">Entrar</button>
      </form>
      <div class="login-footer mx-auto pt-4 pb-6">
        ¿No tienes una cuenta? <a href="#">Regístrate</a>
      </div>
    </div>
    <div
      class="card-2 col-span-4 bg-linear-to-br from-secondary to-primary text-center flex flex-col justify-center p-6 rounded-r-2xl text-white"
    >
      <div>
        <h3 class="text-2xl uppercase font-bold mb-2">Salmos 33:2-3</h3>
        <p class="text-sm opacity-90 w-full m-auto px-6 text-pretty">
          Aclamad a Jehová con arpa; Cantadle con salterio y decacordio.
          Cantadle cántico nuevo; Hacedlo bien, tañendo con júbilo.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Decoración de fondo inspirada en la landing */

  body::before {
    content: "";
    position: absolute;
    top: -10%;
    left: -10%;
    width: 400px;
    height: 400px;
    background: radial-gradient(
      circle,
      rgba(59, 138, 142, 0.15) 0%,
      transparent 70%
    );
    z-index: -1;
  }

  body::after {
    content: "";
    position: absolute;
    bottom: -10%;
    right: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(
      circle,
      rgba(30, 78, 94, 0.12) 0%,
      transparent 70%
    );
    z-index: -1;
  }

  .login-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    width: 100%;
    max-width: 800px;
    border-radius: 40px;
    box-shadow: var(--shadow);
    border: 1px solid rgba(255, 255, 255, 0.8);
    text-align: center;
    z-index: 10;
  }

  .back-home {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text-light);
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 30px;
    transition: color 0.3s;
  }

  .back-home:hover {
    color: var(--secondary);
  }

  .logo-login {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-bottom: 35px;
  }

  .logo-icon {
    width: 55px;
    height: 55px;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: 0 8px 16px rgba(30, 78, 94, 0.2);
  }

  .logo-login h2 {
    font-size: 24px;
    font-weight: 900;
    color: var(--primary);
    letter-spacing: -0.5px;
  }

  .login-title h3 {
    font-size: 28px;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 8px;
  }

  .login-title p {
    color: var(--text-light);
    font-size: 15px;
    font-weight: 500;
  }

  /* Botones Sociales */

  .btn-google {
    width: 80%;
    padding: 14px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-weight: 700;
    color: var(--text-dark);
    cursor: pointer;
    transition: all 0.3s;
    font-size: 15px;
    margin: 0 auto;
  }

  .btn-google:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
    transform: translateY(-2px);
  }

  .btn-google img {
    width: 20px;
    height: 20px;
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
    color: #111;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .divider::before,
  .divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  /* Formulario */
  .form-group {
    text-align: left;
    margin-bottom: 12px;
    position: relative;
  }

  .form-group label {
    display: block;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 9px;
    margin-left: 4px;
  }

  .input-wrapper {
    position: relative;
  }

  .input-wrapper i {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-light);
    width: 18px;
  }

  .form-control {
    width: 100%;
    padding: 12px 14px 12px 46px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: #fcfdfe;
    font-size: 15px;
    outline: none;
    transition: all 0.3s;
  }

  .form-control:focus {
    border-color: var(--secondary);
    background: white;
    box-shadow: 0 0 0 4px rgba(59, 138, 142, 0.1);
  }

  .forgot-password {
    display: block;
    text-align: right;
    font-size: 13px;
    font-weight: 700;
    color: var(--secondary);
    text-decoration: none;
    margin-top: 8px;
  }

  .forgot-password:hover {
    text-decoration: underline;
  }

  .btn-submit {
    width: 100%;
    background: var(--color-secondary);
    color: white;
    padding: 14px;
    border-radius: 16px;
    border: none;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.3s;
    margin-top: 10px;
  }

  .btn-submit:hover {
    background: #153a46;
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(30, 78, 94, 0.2);
  }

  .login-footer {
    border-top: 1px solid var(--border);

    color: var(--text-light);
    font-weight: 500;
  }

  .login-footer a {
    color: var(--secondary);
    text-decoration: none;
    font-weight: 800;
  }

  .login-footer a:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .login-card {
      padding: 40px 25px;
      border-radius: 30px;
    }
  }
</style>
<script>
  // Pequeña validación visual al enviar
  const form = document.querySelector("form");
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const btn = document.querySelector<HTMLElement>(".btn-submit");

      if (btn) {
        btn.textContent = "Verificando...";
        btn.style.opacity = "0.7";

        setTimeout(() => {
          btn.textContent = "Entrar";
          btn.style.opacity = "1";
          // Aquí iría la lógica de autenticación real
        }, 1500);
      }
    });
  }
</script>
