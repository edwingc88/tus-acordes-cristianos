---
import Layout from "../layouts/Layout.astro"
import StartIcon from "../components/icons/StartIcon.astro"

const title = "Tu Acordes Cristianos";
const description =
  "Encuentra acordes, letras y diagramas para guitarra y piano de tus canciones cristianas favoritas";
const canonical = "https://www.infolavelada.com/songs";
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="w-[90%] max-w-7xl mx-auto flex px-6">
    <!-- Sidebar Izquierdo: Filtros de Categoría -->
    <aside class="w-64 hidden lg:block pr-8 py-10 sidebar-sticky">
      <h3
        class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-8 pl-4"
      >
        Filtrar por Estilo
      </h3>
      <nav class="flex flex-col space-y-1">
        <a
          href="#"
          class="category-item category-active flex items-center justify-between px-4 py-3 rounded-lg text-sm"
        >
          <span>Adoraciones</span>
          <span class="text-[10px] text-slate-300">124</span>
        </a>
        <a
          href="#"
          class="category-item flex items-center justify-between px-4 py-3 rounded-lg text-slate-500 text-sm"
        >
          <span>Alabanzas</span>
          <span class="text-[10px] text-slate-300">86</span>
        </a>
        <a
          href="#"
          class="category-item flex items-center justify-between px-4 py-3 rounded-lg text-slate-500 text-sm"
        >
          <span>Coritos</span>
          <span class="text-[10px] text-slate-300">52</span>
        </a>
        <a
          href="#"
          class="category-item flex items-center justify-between px-4 py-3 rounded-lg text-slate-500 text-sm"
        >
          <span>Júbilo</span>
          <span class="text-[10px] text-slate-300">39</span>
        </a>
        <a
          href="#"
          class="category-item flex items-center justify-between px-4 py-3 rounded-lg text-slate-500 text-sm"
        >
          <span>Urbano</span>
          <span class="text-[10px] text-slate-300">18</span>
        </a>
        <a
          href="#"
          class="category-item flex items-center justify-between px-4 py-3 rounded-lg text-slate-500 text-sm"
        >
          <span>Recientes</span>
          <span class="text-[10px] text-slate-300">22</span>
        </a>
        <a
          href="#"
          class="category-item flex items-center justify-between px-4 py-3 rounded-lg text-slate-500 text-sm border-t mt-4 pt-4"
        >
          <span>Otros</span>
          <span class="text-[10px] text-slate-300">45</span>
        </a>
      </nav>
    </aside>

    <!-- Área Derecha: Resultados de Canciones -->
    <main class="flex-1 py-10">
      <!-- Título y Orden -->
      <div class="flex justify-between items-end mb-8">
        <div>
          <h2
            class="text-xl font-black text-slate-800 tracking-tight uppercase"
          >
            Canciones
          </h2>
          <p class="text-slate-400 text-[11px] mt-0.5">
            Mostrando resultados de Adoración
          </p>
        </div>
        <select
          class="bg-white border border-slate-100 text-slate-500 text-[10px] font-bold uppercase tracking-wider px-3 py-1.5 rounded-lg outline-none cursor-pointer"
        >
          <option>Más Populares</option>
          <option>A - Z</option>
          <option>Nuevos</option>
        </select>
      </div>

      <!-- Grid de Canciones (Tarjetas más pequeñas) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
        <!-- Card 1 -->
        <div
          class="song-card bg-white p-4 rounded-2xl flex flex-col justify-between group cursor-pointer"
        >
          <div class="flex justify-between items-start mb-3">
            <span
              class="text-[8px] font-black bg-rose-50 text-rose-500 px-2 py-0.5 rounded uppercase tracking-tighter"
              >Adoración</span
            >
            <i
              class="fas fa-heart text-slate-100 group-hover:text-rose-200 transition-colors text-xs"
            ></i>
          </div>
          <div>
            <h3
              class="font-bold text-slate-800 text-base leading-tight group-hover:text-teal-600 transition-colors line-clamp-1"
            >
              La Bondad de Dios
            </h3>
            <p class="text-slate-400 text-[11px] font-medium mt-0.5">
              Bethel Music
            </p>
          </div>
          <div
            class="mt-4 pt-3 border-t border-slate-50 flex items-center justify-between text-slate-300"
          >
            <div class="flex gap-3 text-[10px]">
              <i class="fas fa-guitar"></i>
              <i class="fas fa-keyboard"></i>
            </div>
            <span
              class="text-[9px] font-bold uppercase tracking-widest text-teal-600 opacity-0 group-hover:opacity-100 transition-opacity"
              >Ver <i class="fas fa-chevron-right ml-1"></i></span
            >
          </div>
        </div>

        <!-- Card 2 -->
        <div
          class="song-card bg-white p-4 rounded-2xl flex flex-col justify-between group cursor-pointer"
        >
          <div class="flex justify-between items-start mb-3">
            <span
              class="text-[8px] font-black bg-rose-50 text-rose-500 px-2 py-0.5 rounded uppercase tracking-tighter"
              >Adoración</span
            >
            <i
              class="fas fa-heart text-slate-100 group-hover:text-rose-200 transition-colors text-xs"
            ></i>
          </div>
          <div>
            <h3
              class="font-bold text-slate-800 text-base leading-tight group-hover:text-teal-600 transition-colors line-clamp-1"
            >
              Way Maker
            </h3>
            <p class="text-slate-400 text-[11px] font-medium mt-0.5">
              Priscilla Bueno
            </p>
          </div>
          <div
            class="mt-4 pt-3 border-t border-slate-50 flex items-center justify-between text-slate-300"
          >
            <div class="flex gap-3 text-[10px]">
              <i class="fas fa-keyboard"></i>
            </div>
            <span
              class="text-[9px] font-bold uppercase tracking-widest text-teal-600 opacity-0 group-hover:opacity-100 transition-opacity"
              >Ver <i class="fas fa-chevron-right ml-1"></i></span
            >
          </div>
        </div>

        <!-- Card 3 -->
        <div
          class="song-card bg-white p-4 rounded-2xl flex flex-col justify-between group cursor-pointer"
        >
          <div class="flex justify-between items-start mb-3">
            <span
              class="text-[8px] font-black bg-rose-50 text-rose-500 px-2 py-0.5 rounded uppercase tracking-tighter"
              >Adoración</span
            >
            <i
              class="fas fa-heart text-slate-100 group-hover:text-rose-200 transition-colors text-xs"
            ></i>
          </div>
          <div>
            <h3
              class="font-bold text-slate-800 text-base leading-tight group-hover:text-teal-600 transition-colors line-clamp-1"
            >
              Preciosa Sangre
            </h3>
            <p class="text-slate-400 text-[11px] font-medium mt-0.5">
              Julio Melgar
            </p>
          </div>
          <div
            class="mt-4 pt-3 border-t border-slate-50 flex items-center justify-between text-slate-300"
          >
            <div class="flex gap-3 text-[10px]">
              <i class="fas fa-guitar"></i>
            </div>
            <span
              class="text-[9px] font-bold uppercase tracking-widest text-teal-600 opacity-0 group-hover:opacity-100 transition-opacity"
              >Ver <i class="fas fa-chevron-right ml-1"></i></span
            >
          </div>
        </div>

        <!-- Card 4 -->
        <div
          class="song-card bg-white p-4 rounded-2xl flex flex-col justify-between group cursor-pointer"
        >
          <div class="flex justify-between items-start mb-3">
            <span
              class="text-[8px] font-black bg-rose-50 text-rose-500 px-2 py-0.5 rounded uppercase tracking-tighter"
              >Adoración</span
            >
            <i
              class="fas fa-heart text-slate-100 group-hover:text-rose-200 transition-colors text-xs"
            ></i>
          </div>
          <div>
            <h3
              class="font-bold text-slate-800 text-base leading-tight group-hover:text-teal-600 transition-colors line-clamp-1"
            >
              Hermoso Nombre
            </h3>
            <p class="text-slate-400 text-[11px] font-medium mt-0.5">
              Hillsong Worship
            </p>
          </div>
          <div
            class="mt-4 pt-3 border-t border-slate-50 flex items-center justify-between text-slate-300"
          >
            <div class="flex gap-3 text-[10px]">
              <i class="fas fa-guitar"></i>
              <i class="fas fa-keyboard"></i>
            </div>
            <span
              class="text-[9px] font-bold uppercase tracking-widest text-teal-600 opacity-0 group-hover:opacity-100 transition-opacity"
              >Ver <i class="fas fa-chevron-right ml-1"></i></span
            >
          </div>
        </div>
      </div>

      <!-- Paginación Simple -->
      <div class="mt-12 flex justify-center items-center gap-1">
        <button
          class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:bg-slate-100 transition-all"
          ><i class="fas fa-chevron-left text-[10px]"></i></button
        >
        <button
          class="w-8 h-8 rounded-lg flex items-center justify-center bg-teal-600 text-white font-black text-[10px]"
          >1</button
        >
        <button
          class="w-8 h-8 rounded-lg flex items-center justify-center bg-white text-slate-400 font-bold text-[10px] border border-slate-100 hover:border-teal-600 transition-all"
          >2</button
        >
        <button
          class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:bg-slate-100 transition-all"
          ><i class="fas fa-chevron-right text-[10px]"></i></button
        >
      </div>
    </main>
  </div>
</Layout>
<style>
  @import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&display=swap");

  body {
    font-family: "Inter", sans-serif;
    background-color: #fcfcfc;
    color: #1e293b;
  }

  .category-item {
    transition: all 0.2s ease;
  }

  .category-item:hover {
    background-color: #f8fafc;
    color: #0d9488;
  }

  .category-active {
    color: #0d9488;
    font-weight: 700;
    border-left: 3px solid #0d9488;
  }

  .song-card {
    transition: all 0.3s ease;
    border: 1px solid #f1f5f9;
  }

  .song-card:hover {
    border-color: #0d948844;
    box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.05);
  }

  .header-search {
    background: #f1f5f9;
  }

  .sidebar-sticky {
    position: sticky;
    top: 5rem;
    height: calc(100vh - 5rem);
  }
</style>
