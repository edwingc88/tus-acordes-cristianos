---
interface Props {
  scale?: string;
  className?: string;
}

const { scale = "scale-100", className = "" } = Astro.props;
---

<a
  href="/"
  class={`flex items-center gap-1.5 cursor-pointer ${scale} ${className} origin-left`}
>
  <div class=`w-12 h-12 flex justify-between text-white relative `>
    <img src="/public/tus.png" alt="Logo" />
  </div>
  <div class="flex flex-col justify-center">
    <h1 class="text-xl font-bold text-primary leading-none tracking-[1.4px]">
      ACORDES
    </h1>
    <span class="text-sm font-semibold text-secondary tracking-[2px]"
      >CRISTIANOS</span
    >
  </div>
</a>
