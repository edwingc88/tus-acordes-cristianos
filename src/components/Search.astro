---
 import SearchIcon from "./icons/SearchIcon.astro"
---
       
<div class="search-container  w-full mx-auto relative p-1.5 ">
    <SearchIcon class="w-5 h-5 stroke-current absolute left-4 top-1/2 -translate-y-1/2 text-text-light"/>
    <input type="text" class=" text-sm search-bar w-full py-3 pr-6 pl-10 border border-slate-200 rounded-4xl shadow-[0_20px_40px_rgba(0,0,0,0.05)] outline-none transition-all focus:border-secondary focus:shadow-[0_20px_40px_rgba(59,138,142,0.1)]" placeholder="Buscar canción, artista ...">
    <button class="text-sm btn-search absolute right-3 top-1/2 -translate-y-1/2 bg-secondary text-white border-none py-1.5 px-6 rounded-4xl font-bold cursor-pointer hover:bg-primary">Buscar</button>
</div >